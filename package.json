{
  "name": "@stonyx/rest-server",
  "keywords": [
    "stonyx-async",
    "stonyx-module"
  ],
  "version": "0.2.1-beta.38",
  "description": "Rest Server Module for Stonyx Framework",
  "repository": {
    "type": "git",
    "url": "https://github.com/abofs/stonyx-rest-server"
  },
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "pnpm build && pnpm build:test && stonyx test 'dist-test/test/**/*-test.js'",
    "prepublishOnly": "npm test"
  },
  "author": "Stone Costa",
  "license": "Apache-2.0",
  "contributors": [
    "Stone Costa <stone.costa@synamicd.com>"
  ],
  "files": [
    "dist",
    "config",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "stonyx": "0.2.3-beta.12"
  },
  "devDependencies": {
    "@stonyx/utils": "0.2.3-beta.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "@types/qunit": "^2.19.13",
    "@types/sinon": "^21.0.1",
    "qunit": "^2.24.1",
    "sinon": "^21.0.0",
    "typescript": "^5.8.3"
  }
}
